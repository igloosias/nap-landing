---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

const {
  brand, primaryCta, heroImage, logo, serviceImages, nav,
  services, serviceNotes, how, stats, faq, visit
} = site;

const navLinks = nav;

// Helper: WhatsApp deep-link with pre-filled message
const waFor = (serviceName) => {
  const phone = brand.whatsappNumber;
  const msg = `Hi NAP, I'd like to book the ${serviceName}.`;
  return `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
};
const waGeneral = `https://wa.me/${brand.whatsappNumber}`;
---

<Layout>
  <main id="main">

    <!-- ============================================================== -->
    <!-- HERO — full-bleed image, parallax, layered text              -->
    <!-- ============================================================== -->
    <section class="hero" aria-labelledby="hero-title">
      <img
        class="hero-image"
        src={heroImage.src}
        alt=""
        aria-hidden="true"
        width="1600"
        height="872"
        loading="eager"
        decoding="async"
        data-parallax
      />
      <div class="hero-scrim" aria-hidden="true"></div>

      <div class="hero-overlay">
        <header class="hero-top">
          <a href="/" class="brand" aria-label={`${brand.name} home`}>
            <img class="brand-logo" src={logo.src} alt={logo.alt} width="96" height="82" />
          </a>

          <nav class="nav-links" data-slide-tabs aria-label="Primary">
            <span class="nav-cursor" aria-hidden="true"></span>
            {navLinks.map((l, i) => (
              <a href={l.href} class="nav-link" data-nav-link data-active={i === 0 ? "true" : "false"}>{l.label}</a>
            ))}
          </nav>
        </header>

        <div class="hero-bottom">
          <h1 id="hero-title" class="display hero-display">
            <span class="hero-row row-1">Nails<span class="hero-dot">.</span></span>
            <span class="hero-row row-2">Lashes<span class="hero-dot">.</span></span>
            <span class="hero-row row-3">Booked<span class="hero-dot">.</span></span>
          </h1>
          <p class="hero-prestige"><span class="script">{brand.heroPrestige}</span></p>

          <div class="hero-cta">
            <a href={waGeneral} class="cta-pink cta-pill" target="_blank" rel="noopener" aria-label="Book now on WhatsApp">
              <span>Book now</span>
              <svg class="cta-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"/>
              </svg>
            </a>
            <p class="mono hero-meta-line">{brand.hoursWeekday} · {brand.hoursWeekend}</p>
            <p class="mono hero-fee-line">{brand.bookingFee}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- SERVICES — two dedicated sections (nails first, lashes second) -->
    <!-- ============================================================== -->
    <div class="services-wrap">
      <div class="services-half-bg" aria-hidden="true"></div>
    <section id="nails" class="section services-half services-half--img-left" aria-labelledby="nails-title">
      <div class="services-half-grid">
        <figure class="services-half-figure">
          <img
            src="/assets/nail-section.webp"
            alt={serviceImages.alt.nails}
            width="1280"
            height="698"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="services-half-caption">The Menu</figcaption>
        </figure>

        <div class="services-half-text">
          <h2 id="nails-title" class="display services-half-title">Nails</h2>

          <details class="services-dropdown">
            <summary class="services-dropdown-summary">
              <span class="mono services-dropdown-eyebrow">Tap to view {services[0].items.length} services</span>
              <svg class="services-dropdown-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
              </svg>
            </summary>
            <div class="services-dropdown-body">
              <ul class="service-list" role="list">
                {services[0].items.map((s) => (
                  <li class="service-row">
                    <a href={waFor(s.name)} class="service-link" target="_blank" rel="noopener" aria-label={`Book ${s.name} on WhatsApp`}>
                      <span class="service-name">{s.name}</span>
                      <span class="service-price">{s.price}</span>
                    </a>
                  </li>
                ))}
              </ul>
              {services[0].extensions && (
                <div class="services-sub">
                  <p class="mono services-sub-kicker">Nail extensions &amp; add-ons</p>
                  <ul class="service-list service-list-sub" role="list">
                    {services[0].extensions.map((s) => (
                      <li class="service-row">
                        <a href={waFor(s.name)} class="service-link" target="_blank" rel="noopener" aria-label={`Book ${s.name} on WhatsApp`}>
                          <span class="service-name">{s.name}</span>
                          <span class="service-price">{s.price}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </details>
        </div>
      </div>
    </section>

    <div class="services-divider" aria-hidden="true">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none" focusable="false">
        <path d="M4 30 c38.8 -1.0 49.7 -14.4 77.6 16.0 c15.7 14.5 46.1 -11.0 58.0 -4.5 c5.3 1.7 34.5 -13.1 36.2 10.6 c11.3 -15.8 56.2 0.4 69.0 0.0 c8.9 1.1 56.7 -16.1 61.0 0.0 c5.2 15.1 41.9 15.1 62.8 0.0 c12.2 8.6 28.9 -14.3 33.0 -11.1 c16.5 16.1 67.9 11.7 71.4 10.3 c19.0 4.7 51.8 -14.3 79.4 -0.6 c35.6 -4.8 41.4 -6.9 51.8 -4.6 c16.3 -3.0 50.5 -4.3 72.2 4.3 c9.0 6.9 39.9 -11.2 52.0 -1.7 c6.7 -4.2 54.6 -3.4 62.3 2.3 c13.2 -1.9 30.1 -9.8 35.2 1.0 c22.3 15.9 34.9 -16.7 47.2 -7.4 c8.0 13.8 54.3 7.7 72.1 -11.6 c19.3 17.2 15.8 -16.5 31.8 -8.0 c13.0 -10.0 33.0 -2.7 52.0 7.2 c15.2 11.6 31.3 -3.4 42.5 -14.6 c20.3 12.7 45.1 -6.6 74.2 15.7 c16.2 -7.4 20.1 -16.3 43.7 -9.0 c23.7 16.5 15.6 12.6 42.0 15.8 c19.6 13.1 30.9 7.7 49.1 7.0 c19.1 7.4 36.7 14.8 32.5 -14.9 c1.3 -1.8 27.1 5.4 53.3 6.8 c9.0 16.3 45.6 -17.8 40.4 -11.7 c24.1 11.3 29.5 9.1 56.5 5.5 c4.1 15.7 40.3 13.5 50.3 -12.9" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M4 34 c16.4 -2.2 37.9 -9.8 63.1 -9.1 c4.9 -13.5 47.2 10.2 83.2 13.8 c12.6 -2.2 50.6 -17.2 57.5 6.6 c15.4 -17.0 48.1 -0.7 57.8 -14.6 c7.2 2.7 35.9 -10.2 32.7 -14.2 c9.4 4.3 52.0 4.3 65.4 -8.5 c20.3 4.8 28.1 -17.1 35.6 3.6 c14.1 8.6 46.8 6.4 55.3 12.3 c28.2 9.4 58.4 -4.9 72.2 -2.9 c13.2 -16.9 68.2 -8.3 83.3 -4.7 c4.4 4.8 16.8 -2.6 31.5 -0.8 c17.6 13.7 40.5 -3.9 41.9 -2.2 c18.8 5.4 29.7 1.2 48.7 14.2 c14.4 6.4 29.3 2.9 46.3 -7.5 c34.3 5.5 44.7 -10.8 68.8 4.8 c4.0 -2.8 43.8 -4.8 46.5 12.7 c26.1 -5.9 40.3 5.2 71.9 2.8 c7.8 17.8 42.1 4.2 51.6 2.0 c20.7 17.8 14.3 -13.4 39.5 9.5 c27.6 -11.5 56.5 15.0 73.8 0.0 c27.2 9.4 52.8 9.9 61.0 0.0 c11.4 -3.2 61.7 -2.3 64.5 0.0 c7.5 -11.7 35.4 10.6 45.5 -15.8 c22.8 7.2 31.9 4.2 54.3 -8.6 c33.6 -16.8 42.4 10.2 67.0 -1.9 c26.9 -16.4 32.9 -12.7 49.3 -15.0 c23.0 0.2 47.5 -6.5 72.5 5.5 c11.7 4.4 20.3 -9.7 38.6 13.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.55" />
      </svg>
    </div>

    <section id="lashes" class="section services-half services-half--img-right" aria-labelledby="lashes-title">
      <div class="services-half-grid">
        <div class="services-half-text">
          <h2 id="lashes-title" class="display services-half-title">Lashes</h2>

          <details class="services-dropdown">
            <summary class="services-dropdown-summary">
              <span class="mono services-dropdown-eyebrow">Tap to view {services[1].items.length} services</span>
              <svg class="services-dropdown-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M8 3v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
              </svg>
            </summary>
            <div class="services-dropdown-body">
              <ul class="service-list" role="list">
                {services[1].items.map((s) => (
                  <li class="service-row">
                    <a href={waFor(s.name)} class="service-link" target="_blank" rel="noopener" aria-label={`Book ${s.name} on WhatsApp`}>
                      <span class="service-name">{s.name}</span>
                      <span class="service-price">{s.price}</span>
                    </a>
                  </li>
                ))}
              </ul>
              {services[1].refills && (
                <div class="services-refill">
                  <p class="mono services-sub-kicker">Lash refill</p>
                  <ul class="service-list service-list-sub" role="list">
                    {services[1].refills.map((r) => (
                      <li class="service-row">
                        <a href={waFor(`Lash refill · ${r.weeks}`)} class="service-link" target="_blank" rel="noopener" aria-label={`Book Lash refill · ${r.weeks} on WhatsApp`}>
                          <span class="service-name">{r.weeks}</span>
                          <span class="service-price">{r.fromPrice}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </details>
        </div>

        <figure class="services-half-figure">
          <img
            src="/assets/lash-section.webp"
            alt={serviceImages.alt.lashes}
            width="1280"
            height="698"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="services-half-caption">The Menu</figcaption>
        </figure>
      </div>
    </section>

    <ul class="services-notes container">
      {serviceNotes.map((n) => (
        <li class="mono services-note-line">— {n}</li>
      ))}
    </ul>
    </div>

    <!-- ============================================================== -->
    <!-- HOW IT WORKS — sample chats                                   -->
    <!-- ============================================================== -->
    <section id="how" class="section how" aria-labelledby="how-title">
      <div class="container">
        <div class="section-head-row">
          <div>
            <p class="mono kicker">Chapter 03</p>
            <h2 id="how-title" class="display section-h2">How it works<span class="dot">·</span></h2>
          </div>
          <p class="italic section-lede">{how.lede}</p>
        </div>

        <ol class="how-steps" role="list">
          {how.steps.map((s, i) => (
            <li class:list={["how-step", i > 0 ? "how-step-bordered" : ""]}>
              <div class="how-step-head">
                <span class="display how-step-num">{s.n}</span>
                <span class="mono how-step-tag">{s.tag}</span>
              </div>
              <h3 class="display how-step-t">{s.title}</h3>
              <p class="how-step-body">{s.body}</p>
              <div class="how-step-sample">
                <p class="mono how-sample-who">{s.sample.who}</p>
                <p class="italic how-sample-text">"{s.sample.text}"</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="how-foot">
          <p class="italic how-foot-text">{how.footnote}</p>
          <a href={waGeneral} class="cta-pink cta-pill" target="_blank" rel="noopener">
            Open WhatsApp
            <svg class="cta-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- STATS — by the numbers                                        -->
    <!-- ============================================================== -->
    <section class="section stats" aria-labelledby="stats-title">
      <div class="container">
        <div class="section-head-row">
          <div>
            <p class="mono kicker">Chapter 04</p>
            <h2 id="stats-title" class="display section-h2">By the numbers<span class="dot">·</span></h2>
          </div>
          <p class="italic section-lede">Four years in the same room, one chair at a time.</p>
        </div>

        <div class="stats-grid">
          {stats.map((s) => (
            <div class="stats-cell">
              <p class="mono stats-kicker">{s.label}</p>
              <p class="display stats-value">{s.value}</p>
              <p class="italic stats-note">{s.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- FAQ — sticky side panel                                       -->
    <!-- ============================================================== -->
    <section id="faq" class="section faq" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="faq-side">
          <p class="mono kicker">Chapter 05</p>
          <h2 id="faq-title" class="display section-h2">Questions<span class="dot">·</span></h2>
          <p class="italic faq-side-lede">The things people ask us on WhatsApp, collected. If yours isn't here, just send it — we answer fast.</p>
          <a href={waGeneral} class="cta-pink cta-pill faq-side-cta" target="_blank" rel="noopener">
            Ask us directly
            <svg class="cta-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"/>
            </svg>
          </a>
        </div>

        <div class="faq-list-wrap" data-faq-list>
          {faq.map((f, i) => (
            <details class="faq-item" open={i === 0 ? "" : undefined}>
              <summary class="faq-summary">
                <div>
                  <p class="mono faq-meta">{f.n} — {f.tag}</p>
                  <h3 class="display faq-q">{f.q}</h3>
                </div>
                <svg class="faq-chev" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                  <path d="M5 14h18M14 5v18" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
                </svg>
              </summary>
              <div class="faq-a-wrap">
                <p class="italic faq-a">{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- VISIT — come take a nap                                       -->
    <!-- ============================================================== -->
    <section id="visit" class="section visit" aria-labelledby="visit-title">
      <div class="container visit-grid">
        <div class="visit-left">
          <p class="mono kicker visit-kicker">Chapter 06 — {visit.eyebrow}</p>
          <h2 id="visit-title" class="display visit-title">
            {visit.titleLead} <span class="italic visit-accent">{visit.titleAccent}</span><br />{visit.titleTrail}<span class="dot">·</span>
          </h2>
          <p class="italic visit-lede">{visit.lede}</p>

          <div class="visit-ctas">
            {visit.ctas.map((c) => (
              <a href={c.href} class={c.primary ? "cta-pink cta-pill" : "cta-ghost cta-pill"} target="_blank" rel="noopener">
                <span>{c.label}</span>
                <svg class="cta-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"/>
                </svg>
              </a>
            ))}
          </div>
        </div>

        <dl class="visit-details">
          {visit.details.map((d) => (
            <div class="visit-row">
              <dt class="mono visit-row-k">{d.label}</dt>
              <dd class="visit-row-v">
                {d.value.map((line) => (
                  <p>{line}</p>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- FOOTER                                                         -->
    <!-- ============================================================== -->
    <footer class="footer" aria-label="Footer">
      <div class="container footer-top">
        <div>
          <img class="footer-logo" src={logo.src} alt={logo.alt} width="160" height="136" />
          <p class="footer-tag italic">{brand.footerTagline || "A single-chair studio for nails & lashes."}</p>
        </div>
        <div class="footer-social">
          <a href={`https://instagram.com/${brand.instagramHandle.replace(/^@/, "")}`} class="footer-link" target="_blank" rel="noopener">{brand.instagramHandle}</a>
          <a href={`https://tiktok.com/@${brand.tiktokHandle.replace(/^@/, "")}`} class="footer-link" target="_blank" rel="noopener">{brand.tiktokHandle}</a>
        </div>
      </div>

      <div class="container footer-bottom">
        <p class="mono footer-fine">© 2025 {brand.company}</p>
        <p class="mono footer-fine footer-fine-mid">Site set in General Sans, JetBrains Mono & Spectral · Built slowly in Singapore</p>
        <p class="mono footer-fine footer-status"><span class="blink-dot blink-dot-pink" aria-hidden="true"></span>Accepting bookings</p>
      </div>
    </footer>

    <!-- ============================================================== -->
    <!-- STICKY MOBILE CTA                                              -->
    <!-- ============================================================== -->
    <div class="sticky-cta" data-sticky-cta aria-hidden="true">
      <a href={waGeneral} class="cta-pink cta-pill" target="_blank" rel="noopener">
        Book on WhatsApp
        <svg class="cta-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter"/>
        </svg>
      </a>
    </div>
  </main>
</Layout>

<style>
  /* ============================================================== */
  /* EDITORIAL NARRATIVE — primitives shared across the page        */
  /* ============================================================== */
  :root {
    --ticker-h: 36px;
    --marquee-h: 96px;
  }

  .dot {
    display: inline-block;
    margin: 0 0.18em;
    color: var(--signal);
    transform: translateY(-0.06em);
  }

  .kicker { color: var(--ink-50); }

  /* Blink dot */
  .blink-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #3BC36A;
    animation: blink 1.4s steps(2) infinite;
  }
  .blink-dot-pink { background: var(--signal); }
  @keyframes blink { 50% { opacity: 0.25; } }

  /* CTA pills */
  .cta-pink {
    background: var(--signal);
    color: var(--bone);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: transform var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .cta-pink:hover, .cta-pink:focus-visible { transform: translateY(-1px); background: #D43E7C; }
  .cta-ghost {
    background: transparent;
    color: var(--bone);
    border: 1px solid rgba(245, 241, 234, 0.20);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: background var(--dur-fast) var(--ease);
  }
  .cta-ghost:hover, .cta-ghost:focus-visible { background: rgba(245, 241, 234, 0.08); }

  .cta-pill {
    border-radius: 999px;
    padding: 14px 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* ============================================================== */
  /* NAV (slide-tabs, layered on hero)                              */
  /* ============================================================== */
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.18em;
    text-decoration: none;
    color: inherit;
  }
  .brand-logo {
    display: block;
    height: 64px;
    width: 64px;
  }
  @media (min-width: 768px) {
    .brand-logo { height: 88px; width: 88px; }
  }
  .nav-links {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    position: relative;
    padding: 4px;
    border: 1px solid rgba(245, 241, 234, 0.20);
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .nav-link {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 241, 234, 0.78);
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 999px;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav-link[data-active="true"],
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--ink);
  }
  .nav-cursor {
    position: absolute;
    top: 4px;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 999px;
    background: var(--bone);
    z-index: 0;
    opacity: 0;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
    pointer-events: none;
    /* width/height are set instantly via JS — no transition on layout props */
  }
  .nav-cta {
    background: var(--signal);
    color: var(--bone);
    border-radius: 999px;
    padding: 10px 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: background var(--dur-fast) var(--ease);
  }
  .nav-cta:hover, .nav-cta:focus-visible { background: #D43E7C; }

  /* ============================================================== */
  /* HERO — full-bleed image with layered text                    */
  /* ============================================================== */
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--ink);
    color: var(--bone);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
