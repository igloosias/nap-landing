---
/**
 * NAP — Direction Contract
 * THESIS: The appointment is the look. Each booking is a fashion cover. Refuse the soft-pink beauty default.
 * OWN-WORLD: #0A0A0A near-black, #F5F1EA bone white, #E8334E signal red, #F2D8D8 blush. General Sans 700 display, JetBrains Mono micro-labels, Spectral italic accent. Sharp 4px corners. 1px hairline dividers.
 * STORY: Visitor sees a full-bleed artist portrait and a monumental "BOOKED" word fragmenting to reveal "with your artist". They tap "See open slots" or scroll: how it works, featured artists, pricing, FAQ.
 * FIRST VIEWPORT: portrait occupies right 60%, NAP brand mark top-left, "BOOKED" 180px centered-left with letters fragmenting at the bottom to "with your artist" in italic serif. Signal-red "See open slots" CTA below. Mono "OPEN NOW IN YOUR CITY" above the CTA. Mono links top-right.
 * FORM: SSENSE Editorial, position 3 of 7, seed key b1654aa2.
 * RAISES (carried into this build):
 *   — DESIGNED ABSENCE (from declined seven-segment): sections hold negative space as deliberate as type; 40% of every fold is deliberate white space.
 *   — LACQUERED SATURATION (from declined lowbrow gallery): the signal red is held as a flat unmissable block, never a hover tint.
 *   — RESERVED BLOOM (from declined pixel-art CRT): a single soft glow on the primary action; everything else stays matte.
 *   — MONUMENTAL TYPE BEHAVES LIKE MATTER (from challenger alphabet-storm): the hero word "BOOKED" fragments with a CSS clip-path animation.
 * FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
 */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NAP — Booked with your artist",
  description = "The fastest path from want-to-book to confirmed appointment with a vetted nail or lash artist.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/hero-product.webp" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/hero-product.webp" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Italiana&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script type="module" src="/scripts/scroll.mjs"></script>
    <script type="module" src="/scripts/slide-tabs.mjs"></script>
  </body>
</html>